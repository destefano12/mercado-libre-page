      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Config.luau — single source of truth for every tunable in Mimic Party.
-- Nothing else in the codebase hardcodes a number that belongs here.

local Config = {}

-- ─── Match shape ──────────────────────────────────────────────────────────────
Config.MIN_PLAYERS = 2
Config.MAX_PLAYERS = 5
Config.ROUNDS_PER_PARTY = 4

-- ─── Phase durations (seconds) ────────────────────────────────────────────────
Config.PHASE = {
	LOBBY_COUNTDOWN = 20,  -- shortens to QUICK_START once the room is full
	QUICK_START = 6,
	PROCESSION = 7.5,      -- players walk from the house to their marks
	ROUND_INTRO = 2.6,
	REFERENCE_PAD = 1.1,   -- breathing room before/after the reference plays
	COUNT_IN = 3,          -- 3 · 2 · 1 · GO
	TAKE_TAIL = 0.45,      -- grace after the take window closes
	PLAYBACK_GAP = 1.5,    -- reaction window between takes
	ROULETTE_SPIN = 4.2,
	SABOTAGE_PICK = 7,
	RESULTS = 11,
}

-- ─── Rooms ────────────────────────────────────────────────────────────────────
-- A private room is a reserved server of this same place. The host creates one,
-- gets a code, and anyone who types that code is teleported into it. The host
-- owns the sound packs and can remove players; nothing else.
Config.ROOM = {
	-- How long a freshly created room waits for people before the host is told
	-- nobody came. Does not kick anyone; it is only a nudge.
	LONELY_AFTER = 120,
	MAX_CREATE_ATTEMPTS = 6,    -- code-collision retries before giving up
	JOIN_COOLDOWN = 3,          -- per player, seconds between join attempts
	CREATE_COOLDOWN = 10,       -- per player, seconds between room creations
	-- A host who leaves hands the room to whoever has been there longest, so a
	-- room does not become unmanageable because one person's wifi died.
	INHERIT_HOST = true,
}

-- ─── Voice chat ───────────────────────────────────────────────────────────────
-- Voice is the point of this game, so the graph is explicit rather than left to
-- the engine's defaults:
--
--   AudioDeviceInput (per player, .Player = them)
--        └─ Wire ─→ AudioEmitter (on their head)
--                        └─ heard by AudioListener (SoundService.ListenerLocation)
--                                 └─ AudioDeviceOutput (engine-provided)
--
-- Owning the wires is what makes the rest possible: muting the table during
-- playback is a real mute on a real input, not a label.
Config.VOICE_CHAT = {
	-- Volume over distance, in studs. The house is ~45 studs deep, so a voice on
	-- stage has to carry to the back row without the five performers turning
	-- into mud when they are all talking at once.
	ATTENUATION = {
		{ 0, 1 },
		{ 18, 0.92 },
		{ 40, 0.68 },
		{ 70, 0.34 },
		{ 100, 0 },
	},
	INPUT_VOLUME = 1,
	-- Set false to let the engine's default voice routing stand untouched.
	CUSTOM_ROUTING = true,
}

-- ─── Input ────────────────────────────────────────────────────────────────────
-- Three ways to perform a take, picked per player at record time:
--   "voice"      real microphone drives loudness/attacks/rhythm, pointer height
--                drives pitch (the melody axis). The default when voice works.
--   "voice_only" real microphone drives everything; melody is dropped and its
--                weight is redistributed. For players who will not touch a mouse.
--   "pointer"    no microphone available: hold to vocalise, as before.
Config.INPUT = {
	DEFAULT = "voice",
	FALLBACK = "pointer",
}

-- ─── Microphone ───────────────────────────────────────────────────────────────
-- Roblox exposes RmsLevel/PeakLevel on a live AudioDeviceInput (client only),
-- but GetSpectrum() is blocked for microphone inputs, so there is no pitch to
-- read. Everything below is about turning a loudness stream into clean onsets.
Config.VOICE = {
	-- The noise floor is measured during the count-in, per player, per take, so
	-- a loud room or a hot mic calibrates itself instead of needing a setting.
	CALIBRATE_FOR = 2.0,
	FLOOR_MIN = 0.0035,       -- never trust a floor quieter than this
	FLOOR_HEADROOM = 1.35,    -- measured floor is scaled by this before gating

	-- Hysteresis: opening and closing on the same threshold chatters badly on
	-- a breathy voice, so the gate opens high and closes low.
	GATE_OPEN = 3.1,          -- × floor
	GATE_CLOSE = 1.7,         -- × floor

	-- These two are set against the library, not by feel. The tightest gap in
	-- SoundLibrary is 90 ms (nothing shorter is articulable by a human voice or
	-- visible to a 60 fps sampler), so:
	--   BRIDGE_GAP  must be comfortably under 90 ms, or a fast pattern collapses
	--               into one attack and the attacks axis — a quarter of the
	--               score — reads zero.
	--   BRIDGE_GAP  must be over ~2 frames (33 ms), or a breathy voice chatters
	--               the gate and one word counts as four.
	-- 40 ms sits in that window with 50 ms of margin on the library side.
	REFRACTORY = 0.05,
	BRIDGE_GAP = 0.04,

	-- RmsLevel is roughly 0..1 but a shout sits far below 1, so the envelope is
	-- normalised against a running peak for the drawing and the level meter.
	LEVEL_CEILING_MIN = 0.05,
	LEVEL_DECAY = 0.75,       -- per second, how fast the running peak falls back
}

-- ─── Recording ────────────────────────────────────────────────────────────────
Config.TAKE = {
	-- One shot. No retries, no undo. This flag exists to be read, never flipped.
	ALLOW_RETRY = false,
	PITCH_RANGE = 9,       -- ± semitones the player can reach with the mouse
	MIN_NOTE = 0.05,       -- shorter than this is a click, not an attack
	MAX_NOTES = 48,
	ENVELOPE_SAMPLES = 96, -- waveform resolution
}

-- ─── Scoring ──────────────────────────────────────────────────────────────────
-- Faithful to the original: melody, rhythm and attacks. Never timbre, never
-- absolute pitch — contours are mean-normalised so registers score equally.
Config.SCORING = {
	WEIGHT_MELODY = 0.40,
	WEIGHT_RHYTHM = 0.35,
	WEIGHT_ATTACKS = 0.25,
	MELODY_SAMPLES = 64,
	MELODY_TOLERANCE = 7.0,  -- semitones of contour error that zeroes the axis
	RHYTHM_TOLERANCE = 0.35, -- seconds of onset error that zeroes the axis
	MAX_SCORE = 1000,
}

-- When a player performs without pitch control ("voice_only"), the melody axis
-- has nothing to measure, so it is dropped and its weight is split between the
-- two axes their voice does drive. Scoring renormalises; totals stay comparable.
Config.SCORING_VOICE_ONLY = {
	WEIGHT_MELODY = 0,
	WEIGHT_RHYTHM = 0.58,
	WEIGHT_ATTACKS = 0.42,
}

-- ─── Roulette ─────────────────────────────────────────────────────────────────
Config.ROULETTE = {
	SABOTAGE_POINT_PENALTY = 120,
	MULTIPLIER_DECAY = 1,    -- multipliers last this many rounds
}

-- ─── Solo modes ───────────────────────────────────────────────────────────────
Config.SURVIVAL = { SOUNDS = 50, LIVES = 3, TARGET_START = 300, TARGET_STEP = 25, TARGET_CAP = 720 }
Config.JUST_PLAY = { ROUNDS = 3 }
Config.DAILY = { SOUNDS = 4 }

-- ─── Presentation ─────────────────────────────────────────────────────────────
Config.STAGE_MARKS = 5
Config.CAMERA_FOV = { HOUSE = 58, WIDE = 52, BOOTH = 36, ROULETTE = 44, CLOSE = 30 }

-- ─── Audio assets ─────────────────────────────────────────────────────────────
-- Every sound in the library runs through a synthesised fallback voice, so the
-- game is fully playable with zero uploads. Drop your own ids here to replace it.
Config.AUDIO = {
	-- A sustained, pitch-neutral tone. The engine pitch-shifts it per note.
	VOICE_TONE = "rbxassetid://9112854440",
	UI_CLICK = "rbxassetid://6042053626",
	UI_CONFIRM = "rbxassetid://6042583426",
	COUNT_TICK = "rbxassetid://9118823101",
	WHEEL_TICK = "rbxassetid://9118823101",
	-- The sabotage that replaces a whole take. Yes, that one.
	SWAP_SFX = "rbxassetid://5338534197",
	APPLAUSE = "rbxassetid://9125573137",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Modes</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Modes.luau — every way to play, in one table.
-- Party runs on the server state machine; the four solo modes run client-side
-- against the same Scoring module, so a solo score and a party score mean
-- exactly the same thing.

local Config = require(script.Parent.Config)

return {
	{
		id = "party",
		name = "Fiesta",
		players = "2–5 · online",
		blurb = "Cuatro rondas. Todos graban a la vez, una sola toma, y la ruleta decide el resto.",
		solo = false,
		rounds = Config.ROUNDS_PER_PARTY,
	},
	{
		id = "passthemic",
		name = "Pasá el Micro",
		players = "2–5 · un dispositivo",
		blurb = "Por turnos en la misma pantalla. Cuatro rondas, resultados locales.",
		solo = true,
		rounds = 4,
		local_turns = true,
	},
	{
		id = "survival",
		name = "Supervivencia",
		players = "1 jugador",
		blurb = ("%d sonidos, %d vidas, y el objetivo sube cada ronda."):format(
			Config.SURVIVAL.SOUNDS, Config.SURVIVAL.LIVES),
		solo = true,
		rounds = Config.SURVIVAL.SOUNDS,
	},
	{
		id = "justplay",
		name = "Suelto",
		players = "1 jugador",
		blurb = "Tres rondas rápidas con ruleta de bonus y rutas: segura, arriesgada o enfocada.",
		solo = true,
		rounds = Config.JUST_PLAY.ROUNDS,
		routes = {
			{ id = "safe",    name = "Segura",    blurb = "Puntaje tal cual.",                     mult = 1.0 },
			{ id = "risky",   name = "Arriesgada", blurb = "×2, pero por debajo de 500 no cuenta.", mult = 2.0, floor = 500 },
			{ id = "focused", name = "Enfocada",  blurb = "Solo melodía, ×1.5.",                    mult = 1.5, axis = "melody" },
		},
	},
	{
		id = "daily",
		name = "Racha Diaria",
		players = "1 jugador",
		blurb = ("%d sonidos iguales para todo el mundo. Se reinicia a las 00:00 UTC."):format(Config.DAILY.SOUNDS),
		solo = true,
		rounds = Config.DAILY.SOUNDS,
		daily = true,
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Net.luau — the only place RemoteEvents are named. The server creates them,
-- the client waits for them; callers on both sides use the same accessor.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "MimicPartyNet"

local Net = {}

-- Server → client
Net.State = "State"                 -- authoritative phase payload
Net.Playback = "Playback"           -- one take is about to play
Net.RouletteSpin = "RouletteSpin"   -- wheel result for the whole table
Net.SabotageHit = "SabotageHit"     -- you were targeted (revealed at playback)
Net.Scores = "Scores"               -- scoreboard delta
Net.Toast = "Toast"                 -- short room-wide notice
Net.RoomState = "RoomState"         -- code, host, pack toggles, roster

-- Client → server
Net.SubmitTake = "SubmitTake"
Net.ChooseCharacter = "ChooseCharacter"
Net.ChooseSabotageTarget = "ChooseSabotageTarget"
Net.SetReady = "SetReady"
Net.RequestSoloScore = "RequestSoloScore"
Net.CreateRoom = "CreateRoom"
Net.JoinRoom = "JoinRoom"
Net.SetPackEnabled = "SetPackEnabled"   -- host only
Net.KickPlayer = "KickPlayer"           -- host only

local ALL = {
	Net.State, Net.Playback, Net.RouletteSpin, Net.SabotageHit, Net.Scores, Net.Toast,
	Net.RoomState,
	Net.SubmitTake, Net.ChooseCharacter, Net.ChooseSabotageTarget, Net.SetReady,
	Net.RequestSoloScore,
	Net.CreateRoom, Net.JoinRoom, Net.SetPackEnabled, Net.KickPlayer,
}

local folder

local function root()
	if folder then
		return folder
	end
	if IS_SERVER then
		folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		for _, name in ipairs(ALL) do
			if not folder:FindFirstChild(name) then
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = folder
			end
		end
	else
		folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, 30)
	end
	return folder
end

function Net.get(name)
	local r = root()
	if not r then
		error("[Net] network folder never replicated", 2)
	end
	local remote = r:FindFirstChild(name) or r:WaitForChild(name, 20)
	if not remote then
		error(("[Net] remote %q is missing"):format(tostring(name)), 2)
	end
	return remote
end

-- Convenience wrappers so call sites read cleanly.
function Net.fireClient(name, player, payload)
	Net.get(name):FireClient(player, payload)
end

function Net.fireAll(name, payload)
	Net.get(name):FireAllClients(payload)
end

function Net.fireServer(name, payload)
	Net.get(name):FireServer(payload)
end

function Net.onServer(name, fn)
	return Net.get(name).OnServerEvent:Connect(fn)
end

function Net.onClient(name, fn)
	return Net.get(name).OnClientEvent:Connect(fn)
end

function Net.init()
	assert(IS_SERVER, "Net.init is server-only")
	root()
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Palette</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Palette.luau — a muted theatre palette. Warm woods, deep plum, brass, cream.
-- Deliberately low-contrast and low-saturation: no neon, no strobes, nothing
-- that fights the performance for attention.

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

return {
	-- Room
	HouseFloor   = rgb(38, 33, 36),
	HouseWall    = rgb(30, 27, 30),
	Scrim        = rgb(22, 20, 23),

	-- Stage
	Deck         = rgb(122, 86, 55),
	DeckDark     = rgb(92, 64, 41),
	Fascia       = rgb(46, 38, 38),
	Trim         = rgb(150, 116, 66),   -- brass
	TrimDark     = rgb(104, 79, 44),
	Truss        = rgb(44, 42, 45),

	-- Curtain
	Curtain      = rgb(84, 40, 56),
	CurtainFold  = rgb(66, 31, 45),
	Valance      = rgb(96, 48, 64),

	-- Crowd
	Crowd        = rgb(26, 24, 28),

	-- Light
	Practical    = rgb(255, 214, 160),
	Wash         = rgb(255, 228, 192),

	-- UI
	Ink          = rgb(18, 17, 20),
	Panel        = rgb(29, 28, 33),
	PanelRaised  = rgb(38, 37, 43),
	Hairline     = rgb(58, 56, 64),
	Cream        = rgb(238, 233, 224),
	Muted        = rgb(150, 145, 156),

	-- The two signature waveform colours, straight from the original.
	Reference    = rgb(226, 188, 74),   -- yellow — the sound you must match
	Yours        = rgb(118, 196, 128),  -- green  — your voice

	-- The hot core each waveform burns to at full level, and the playhead that
	-- rides over it. Red, because it has to read against both tracks at a
	-- glance and it is the one element that is never a score.
	CoreWarm     = rgb(255, 243, 214),
	CoreCool     = rgb(226, 255, 231),
	Playhead     = rgb(232, 72, 66),
	Well         = rgb(11, 10, 13),     -- the near-black inside a waveform frame

	-- Scoreboard cards.
	CardBack     = rgb(33, 31, 37),
	CardLeader   = rgb(226, 188, 74),

	Good         = rgb(118, 196, 128),
	Warn         = rgb(214, 160, 86),
	Bad          = rgb(192, 92, 92),
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Rooms</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Rooms.luau — room codes: the alphabet, the format, and the key naming.
--
-- Shared so the client can reject a malformed code before spending a round
-- trip, and so the server and client can never disagree about what a code is.

local Rooms = {}

-- No O/0, no I/1, no S/5: a code gets read out loud over voice chat, and those
-- are the pairs people get wrong. 32 symbols, 5 places → 33.5M combinations.
Rooms.ALPHABET = "ABCDEFGHJKLMNPQRTUVWXYZ2346789"
Rooms.LENGTH = 5
Rooms.DATASTORE = "MimicPartyRooms_v1"
Rooms.TTL = 60 * 60 * 6    -- a code stops resolving after six hours

-- Codes are generated server-side only; this lives here so the format is
-- defined in one place.
function Rooms.generate(rng)
	rng = rng or Random.new(os.clock() * 1e6 % 2 ^ 31)
	local chars = {}
	for i = 1, Rooms.LENGTH do
		local pick = rng:NextInteger(1, #Rooms.ALPHABET)
		chars[i] = Rooms.ALPHABET:sub(pick, pick)
	end
	return table.concat(chars)
end

-- Accepts what a person typed and returns a canonical code, or nil plus a
-- reason. Lowercase and stray spaces or dashes are the user being normal.
function Rooms.normalise(input)
	if type(input) ~= "string" then
		return nil, "Escribí un código."
	end
	local cleaned = input:upper():gsub("[%s%-_]", "")
	if #cleaned == 0 then
		return nil, "Escribí un código."
	end
	if #cleaned ~= Rooms.LENGTH then
		return nil, ("El código tiene %d caracteres."):format(Rooms.LENGTH)
	end
	for i = 1, #cleaned do
		local c = cleaned:sub(i, i)
		if not Rooms.ALPHABET:find(c, 1, true) then
			return nil, ("“%s” no es un carácter válido."):format(c)
		end
	end
	return cleaned
end

function Rooms.key(code)
	return "room_" .. code
end

-- Pretty-prints a code for display: ABC-DE reads better than ABCDE.
function Rooms.display(code)
	if type(code) ~= "string" or #code ~= Rooms.LENGTH then
		return code or ""
	end
	return code:sub(1, 3) .. "-" .. code:sub(4)
end

return Rooms
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Roulette</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Roulette.luau — the wheel between rounds. One spin, the whole table at once.
--
-- The wheel is the reason this game is not a karaoke scoreboard. Weights are
-- tuned so roughly a third of spins hand somebody a sabotage: enough that the
-- threat is real every round, rare enough that it still lands as an event.

local Sabotages = require(script.Parent.Sabotages)

local Roulette = {}

local segments = {
	{ id = "p50",   kind = "points",     label = "+50",        amount = 50,   weight = 14 },
	{ id = "p100",  kind = "points",     label = "+100",       amount = 100,  weight = 10 },
	{ id = "p150",  kind = "points",     label = "+150",       amount = 150,  weight = 6 },
	{ id = "m15",   kind = "multiplier", label = "×1.5",       amount = 1.5,  weight = 8 },
	{ id = "m20",   kind = "multiplier", label = "×2",         amount = 2.0,  weight = 4 },
	{ id = "sab1",  kind = "sabotage",   label = "SATURACIÓN", sabotage = "saturate", weight = 7 },
	{ id = "sab2",  kind = "sabotage",   label = "ECO",        sabotage = "echo",     weight = 7 },
	{ id = "sab3",  kind = "sabotage",   label = "TONO",       sabotage = "pitch",    weight = 7 },
	{ id = "sab4",  kind = "sabotage",   label = "PICADO",     sabotage = "chop",     weight = 6 },
	{ id = "sab5",  kind = "sabotage",   label = "SUSTITUIR",  sabotage = "swap",     weight = 4 },
	{ id = "none",  kind = "nothing",    label = "APLAUSO",    weight = 5 },
}

local total = 0
for _, s in ipairs(segments) do
	total += s.weight
end

function Roulette.segments()
	return segments
end

function Roulette.indexOf(id)
	for i, s in ipairs(segments) do
		if s.id == id then
			return i
		end
	end
	return nil
end

-- Weighted draw. `rng` is passed in so the server stays the only authority.
function Roulette.spin(rng)
	local roll = (rng and rng:NextNumber() or math.random()) * total
	local acc = 0
	for i, s in ipairs(segments) do
		acc += s.weight
		if roll <= acc then
			return i, s
		end
	end
	return #segments, segments[#segments]
end

function Roulette.describe(segment)
	if segment.kind == "points" then
		return ("Te llevás %d puntos."):format(segment.amount)
	elseif segment.kind == "multiplier" then
		return ("Tu próxima ronda vale ×%s."):format(segment.amount)
	elseif segment.kind == "sabotage" then
		local def = Sabotages.get(segment.sabotage)
		return def and ("Elegí a quién: " .. def.blurb) or "Elegí a quién."
	end
	return "Nada. La mesa aplaude igual."
end

return Roulette
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Sabotages</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Sabotages.luau — what the wheel lets you do to somebody else's take.
--
-- Every one of these is a native Roblox SoundEffect, so the ruined take is
-- genuinely ruined in the audio graph rather than faked with a label. The
-- victim finds out only when their own take plays back — nothing here is
-- announced earlier, and that delay is the point.

local Config = require(script.Parent.Config)

local Sabotages = {}

local defs = {
	{
		id = "saturate",
		name = "Saturación",
		blurb = "Su toma sale reventada, al borde del clip.",
		icon = "▲",
		apply = function(sound)
			local fx = Instance.new("DistortionSoundEffect")
			fx.Level = 0.72
			fx.Parent = sound
			local gain = Instance.new("EqualizerSoundEffect")
			gain.LowGain = 4
			gain.MidGain = 6
			gain.HighGain = -2
			gain.Parent = sound
			return function()
				fx:Destroy()
				gain:Destroy()
			end
		end,
	},
	{
		id = "echo",
		name = "Eco",
		blurb = "Se repite, y se repite, y se repite.",
		icon = "◌",
		apply = function(sound)
			local fx = Instance.new("EchoSoundEffect")
			fx.Delay = 0.19
			fx.Feedback = 0.62
			fx.DryLevel = 0
			fx.WetLevel = -2
			fx.Parent = sound
			return function()
				fx:Destroy()
			end
		end,
	},
	{
		id = "pitch",
		name = "Cambio de tono",
		blurb = "Ardilla o demonio. No elige quién lo recibe.",
		icon = "◆",
		apply = function(sound)
			local fx = Instance.new("PitchShiftSoundEffect")
			fx.Octave = (math.random() < 0.5) and 0.58 or 1.72
			fx.Parent = sound
			return function()
				fx:Destroy()
			end
		end,
	},
	{
		id = "chop",
		name = "Picado",
		blurb = "La toma se corta en pedazos a media frase.",
		icon = "▌",
		apply = function(sound)
			-- A hard gate on the fader: Roblox has no stutter effect, so we cut
			-- the volume on a fixed grid while the take plays.
			local original = sound.Volume
			local alive = true
			task.spawn(function()
				local open = true
				while alive and sound.Parent do
					sound.Volume = open and original or 0
					open = not open
					task.wait(0.085)
				end
			end)
			return function()
				alive = false
				if sound.Parent then
					sound.Volume = original
				end
			end
		end,
	},
	{
		id = "swap",
		name = "Sustitución",
		blurb = "La mesa no escucha su voz. Escucha otra cosa.",
		icon = "✖",
		-- Handled upstream by the audio engine: the take is never rendered,
		-- Config.AUDIO.SWAP_SFX plays in its place.
		replacesTake = true,
		apply = function()
			return function() end
		end,
	},
}

local byId = {}
for _, d in ipairs(defs) do
	byId[d.id] = d
end

function Sabotages.all()
	return defs
end

function Sabotages.get(id)
	return byId[id]
end

function Sabotages.penalty()
	return Config.ROULETTE.SABOTAGE_POINT_PENALTY
end

-- Applies a sabotage to a live Sound and returns a cleanup function.
-- Safe to call with nil / unknown ids: you get a no-op cleanup back.
function Sabotages.applyTo(sound, id)
	local def = id and byId[id]
	if not def or not sound then
		return function() end
	end
	local ok, cleanup = pcall(def.apply, sound)
	if not ok or type(cleanup) ~= "function" then
		warn(("[Sabotages] %q failed to apply: %s"):format(tostring(id), tostring(cleanup)))
		return function() end
	end
	return cleanup
end

return Sabotages
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Scoring</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Scoring.luau — melody, rhythm, attacks. Never timbre.
--
-- The one rule that matters: contours are mean-normalised before comparison,
-- so a low voice and a high voice tracing the same shape score identically.
-- Shared verbatim by server (party rounds) and client (solo modes), so a solo
-- run and a party round are graded by the same code path.

local Config = require(script.Parent.Config)

local Scoring = {}
local S = Config.SCORING

local function clamp01(x)
	return math.clamp(x, 0, 1)
end

-- Sample a note list into a per-frame pitch contour plus a voiced mask.
local function contour(notes, duration, samples)
	local pitch = table.create(samples, 0)
	local voiced = table.create(samples, false)
	if duration <= 0 then
		return pitch, voiced
	end
	for i = 1, samples do
		local t = (i - 0.5) / samples * duration
		for _, n in ipairs(notes) do
			if t >= n.t and t <= n.t + n.dur then
				pitch[i] = n.pitch
				voiced[i] = true
				break
			end
		end
	end
	return pitch, voiced
end

-- ── Melody ───────────────────────────────────────────────────────────────────
-- Compared only where both performances are voiced, each side mean-centred.
local function melodyAxis(ref, take, duration)
	local n = S.MELODY_SAMPLES
	local rp, rv = contour(ref.notes, duration, n)
	local tp, tv = contour(take.notes, duration, n)

	local idx, sumR, sumT = {}, 0, 0
	for i = 1, n do
		if rv[i] and tv[i] then
			table.insert(idx, i)
			sumR += rp[i]
			sumT += tp[i]
		end
	end
	if #idx == 0 then
		return 0, 0
	end

	local meanR, meanT = sumR / #idx, sumT / #idx
	local err = 0
	for _, i in ipairs(idx) do
		err += math.abs((rp[i] - meanR) - (tp[i] - meanT))
	end
	err /= #idx

	-- Overlap matters too: nailing the shape of one third of the sound is not
	-- the same as nailing the whole sound.
	local voicedRef = 0
	for i = 1, n do
		if rv[i] then voicedRef += 1 end
	end
	local coverage = voicedRef > 0 and (#idx / voicedRef) or 0

	local shape = clamp01(1 - err / S.MELODY_TOLERANCE)
	return shape * (0.35 + 0.65 * coverage), coverage
end

-- ── Rhythm ───────────────────────────────────────────────────────────────────
-- Onset-to-onset alignment, penalised for dropped or invented onsets.
local function rhythmAxis(ref, take)
	local a, b = ref.notes, take.notes
	local n = math.min(#a, #b)
	if n == 0 then
		return 0
	end
	local err = 0
	for i = 1, n do
		err += math.abs(a[i].t - b[i].t)
	end
	err /= n

	local accuracy = clamp01(1 - err / S.RHYTHM_TOLERANCE)
	local pairing = n / math.max(#a, #b)
	return accuracy * pairing
end

-- ── Attacks ──────────────────────────────────────────────────────────────────
-- How many times you actually hit it. Counting, not shaping.
local function attacksAxis(ref, take)
	local want = #ref.notes
	local got = #take.notes
	if want == 0 then
		return got == 0 and 1 or 0
	end
	return clamp01(1 - math.abs(got - want) / want)
end

-- ── Public ───────────────────────────────────────────────────────────────────
-- `take` is { notes = {...} }.
-- `weights` is optional and overrides the axis weights — used by the voice-only
-- input mode, which has no pitch to measure. Weights are renormalised, so a
-- dropped axis redistributes rather than shrinking the achievable total: a
-- perfect take scores MAX_SCORE under any weighting.
function Scoring.grade(ref, take, weights)
	take = take or { notes = {} }
	local duration = math.max(ref.duration, 0.2)

	local wM = weights and weights.WEIGHT_MELODY or S.WEIGHT_MELODY
	local wR = weights and weights.WEIGHT_RHYTHM or S.WEIGHT_RHYTHM
	local wA = weights and weights.WEIGHT_ATTACKS or S.WEIGHT_ATTACKS
	local sum = wM + wR + wA
	if sum <= 0 then
		wM, wR, wA, sum = S.WEIGHT_MELODY, S.WEIGHT_RHYTHM, S.WEIGHT_ATTACKS, 1
	else
		wM, wR, wA = wM / sum, wR / sum, wA / sum
	end

	local melody, coverage = melodyAxis(ref, take, duration)
	local rhythm = rhythmAxis(ref, take)
	local attacks = attacksAxis(ref, take)

	local blended = melody * wM + rhythm * wR + attacks * wA

	local max = S.MAX_SCORE
	return {
		melody = math.floor(melody * max + 0.5),
		rhythm = math.floor(rhythm * max + 0.5),
		attacks = math.floor(attacks * max + 0.5),
		total = math.floor(blended * max + 0.5),
		coverage = coverage,
		-- Which axes actually counted, so the playback card can grey out the rest.
		weighted = { melody = wM, rhythm = wR, attacks = wA },
	}
end

-- Plain-language verdict for the playback card.
function Scoring.verdict(total)
	if total >= 900 then return "IDÉNTICO" end
	if total >= 780 then return "CLAVADO" end
	if total >= 620 then return "CERCA" end
	if total >= 440 then return "RECONOCIBLE" end
	if total >= 240 then return "LEJOS" end
	return "¿QUÉ FUE ESO?"
end

return Scoring
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Signal.luau — a minimal, allocation-light signal. No dependencies.

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	handlers[fn] = true
	return {
		Disconnect = function()
			handlers[fn] = nil
		end,
	}
end

function Signal:Fire(...)
	for fn in pairs(self._handlers) do
		task.spawn(fn, ...)
	end
end

function Signal:Destroy()
	table.clear(self._handlers)
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">SoundLibrary</string>
          <string name="Source"><![CDATA[--!nonstrict
-- SoundLibrary.luau — the reference sounds.
--
-- Two things define an entry:
--
--   notes    the contour, as { t = onset, dur = length, pitch = semitones }.
--            This drives the scoring and both waveforms, always, in every mode.
--   search   keywords handed to Roblox's own audio library at boot
--            (AssetService:SearchAudioAsync). Whatever comes back is what you
--            actually hear.
--
-- No name here is a meme, a song title or a catchphrase, and no audio file is
-- bundled: the audio is Roblox's, pulled from Roblox's library at runtime, and
-- preference is given to assets Roblox marks as endorsed. If a search returns
-- nothing playable, the contour is rendered through a synthesised tone instead,
-- so a missing asset degrades the sound and never breaks the round.
--
-- To pin an exact asset, set `asset = "rbxassetid://…"` on the entry: the search
-- is skipped and the contour keeps doing everything else.

local Config = require(script.Parent.Config)

local SoundLibrary = {}

local packs = {}
local byId = {}

local function pack(id, name, blurb, entries)
	local p = { id = id, name = name, blurb = blurb, sounds = {} }
	for _, e in ipairs(entries) do
		local notes = {}
		local duration = 0
		for _, n in ipairs(e.notes) do
			local note = { t = n[1], dur = n[2], pitch = n[3] }
			table.insert(notes, note)
			duration = math.max(duration, note.t + note.dur)
		end
		local sound = {
			id = e.id,
			name = e.name,
			difficulty = e.difficulty,     -- 1 easy · 2 medium · 3 hard
			notes = notes,
			duration = duration + 0.12,
			pack = id,
			search = e.search,             -- keywords for the Roblox audio library
			asset = e.asset,               -- set to pin an exact asset
		}
		table.insert(p.sounds, sound)
		byId[sound.id] = sound
	end
	table.insert(packs, p)
	return p
end

-- ── Voces ────────────────────────────────────────────────────────────────────
-- Short vocal shapes. Named for what the contour does, not for any catchphrase.
pack("voces", "Voces", "Formas vocales cortas. Afilado y sin piedad.", {
	{ id = "dosnotas",  name = "Dos Notas",      difficulty = 1, search = { "voice up down", "human voice short" },
	  notes = { {0,0.3,2}, {0.39,0.44,-2} } },
	{ id = "gravelargo", name = "Grave Largo",   difficulty = 1, search = { "deep voice groan", "male voice low" },
	  notes = { {0,0.62,-4} } },
	{ id = "saludo",    name = "Saludo",         difficulty = 2, search = { "voice greeting", "person talking short" },
	  notes = { {0,0.26,0}, {0.35,0.22,3}, {0.66,0.5,-1} } },
	{ id = "latigazo",  name = "Latigazo",       difficulty = 1, search = { "whoosh voice", "swoosh up" },
	  notes = { {0,0.18,-2}, {0.27,0.34,7} } },
	{ id = "asombro",   name = "Asombro",        difficulty = 1, search = { "crowd gasp", "surprise voice" },
	  notes = { {0,0.5,-1}, {0.59,0.4,4} } },
	{ id = "cincogolpes", name = "Cinco Golpes", difficulty = 3, search = { "voice stutter", "chatter short" },
	  notes = { {0,0.16,0}, {0.25,0.16,0}, {0.5,0.16,2}, {0.75,0.18,2}, {1.02,0.42,-3} } },
	{ id = "reproche",  name = "Reproche",       difficulty = 3, search = { "angry voice short", "scold" },
	  notes = { {0,0.22,4}, {0.31,0.2,4}, {0.6,0.26,6}, {0.95,0.46,1} } },
	{ id = "pregunta",  name = "Pregunta",       difficulty = 3, search = { "questioning voice", "voice rising" },
	  notes = { {0,0.2,1}, {0.29,0.18,3}, {0.56,0.18,1}, {0.83,0.2,3}, {1.12,0.44,-2} } },
	{ id = "portazo",   name = "Portazo",        difficulty = 2, search = { "shout down", "voice command" },
	  notes = { {0,0.3,5}, {0.39,0.54,-4} } },
})

-- ── Animales ─────────────────────────────────────────────────────────────────
pack("animales", "Animales", "El paquete que te quita la dignidad primero.", {
	{ id = "gato",     name = "Gato",            difficulty = 2, search = { "cat meow", "kitten" },
	  notes = { {0,0.14,6}, {0.23,0.12,9}, {0.44,0.18,4} } },
	{ id = "estornudo", name = "Estornudo",      difficulty = 1, search = { "dog sneeze", "sneeze" },
	  notes = { {0,0.1,2}, {0.19,0.3,-5} } },
	{ id = "buho",     name = "Búho",            difficulty = 1, search = { "owl hoot", "owl night" },
	  notes = { {0,0.44,-2}, {0.6,0.52,-5} } },
	{ id = "foca",     name = "Foca",            difficulty = 2, search = { "seal bark", "sea lion" },
	  notes = { {0,0.18,-3}, {0.27,0.18,-3}, {0.54,0.22,-5} } },
	{ id = "pajaro",   name = "Pájaro Grande",   difficulty = 2, search = { "large bird call", "squawk" },
	  notes = { {0,0.26,8}, {0.35,0.22,5}, {0.66,0.3,8} } },
	{ id = "risagrave", name = "Risa Grave",     difficulty = 1, search = { "deep laugh", "belly laugh" },
	  notes = { {0,0.24,-6}, {0.33,0.24,-6}, {0.66,0.38,-7} } },
	{ id = "oveja",    name = "Oveja",           difficulty = 3, search = { "sheep bleat", "goat" },
	  notes = { {0,0.3,3}, {0.39,0.16,8}, {0.64,0.6,5} } },
	{ id = "pavoreal", name = "Pavo Real",       difficulty = 3, search = { "peacock call", "exotic bird" },
	  notes = { {0,0.22,7}, {0.31,0.26,2}, {0.66,0.22,7}, {0.97,0.34,1} } },
	{ id = "ranas",    name = "Coro de Ranas",   difficulty = 3, search = { "frog croak", "frogs pond" },
	  notes = { {0,0.14,-4}, {0.23,0.14,-4}, {0.46,0.14,-2}, {0.69,0.14,-4}, {0.92,0.14,-6}, {1.15,0.22,-4} } },
})

-- ── Máquinas ─────────────────────────────────────────────────────────────────
pack("maquinas", "Máquinas", "Acá el ritmo es toda la nota.", {
	{ id = "pitido",   name = "Pitido Triple",   difficulty = 1, search = { "radio beep", "beep beep" },
	  notes = { {0,0.16,4}, {0.32,0.16,4}, {0.64,0.3,4} } },
	{ id = "aviso",    name = "Aviso",           difficulty = 1, search = { "notification", "ui ding" },
	  notes = { {0,0.18,2}, {0.27,0.3,7} } },
	{ id = "error",    name = "Error",           difficulty = 2, search = { "error sound", "buzzer wrong" },
	  notes = { {0,0.22,0}, {0.31,0.22,-5}, {0.62,0.34,-5} } },
	{ id = "timbre",   name = "Timbre",          difficulty = 2, search = { "doorbell", "door chime" },
	  notes = { {0,0.26,5}, {0.35,0.38,0}, {0.82,0.26,5}, {1.17,0.38,0} } },
	{ id = "remate",   name = "Remate",          difficulty = 1, search = { "drum rimshot", "comedy drum" },
	  notes = { {0,0.16,-4}, {0.25,0.16,-2}, {0.5,0.34,6} } },
	{ id = "impresora", name = "Impresora",      difficulty = 3, search = { "printer", "dot matrix" },
	  notes = { {0,0.1,0}, {0.19,0.1,0}, {0.38,0.1,2}, {0.57,0.1,0}, {0.76,0.1,2}, {0.95,0.26,-2} } },
	{ id = "percusion", name = "Percusión",      difficulty = 3, search = { "drum fill", "percussion loop" },
	  notes = { {0,0.12,-6}, {0.21,0.1,4}, {0.4,0.12,-6}, {0.61,0.1,4}, {0.8,0.1,4}, {0.99,0.24,-6} } },
	{ id = "modem",    name = "Módem",           difficulty = 3, search = { "dial up modem", "fax" },
	  notes = { {0,0.22,3}, {0.31,0.18,-2}, {0.58,0.3,6}, {0.97,0.44,-4}, {1.5,0.52,1} } },
	{ id = "glitch",   name = "Glitch",          difficulty = 3, search = { "glitch", "digital error" },
	  notes = { {0,0.1,8}, {0.19,0.1,-6}, {0.38,0.1,8}, {0.57,0.1,-6}, {0.76,0.2,2} } },
})

-- ── Melodías ─────────────────────────────────────────────────────────────────
pack("melodias", "Melodías", "Líneas más largas. El contorno lleva el puntaje.", {
	{ id = "lenta",    name = "Lenta",           difficulty = 1, search = { "simple melody", "soft chime melody" },
	  notes = { {0,0.5,0}, {0.59,0.5,4}, {1.18,0.7,2} } },
	{ id = "fanfarria", name = "Fanfarria",      difficulty = 2, search = { "fanfare", "trumpet short" },
	  notes = { {0,0.26,0}, {0.35,0.26,4}, {0.7,0.26,7}, {1.05,0.58,9} } },
	{ id = "escalera", name = "Escalera",        difficulty = 2, search = { "synth arpeggio up", "scale up" },
	  notes = { {0,0.24,0}, {0.33,0.24,2}, {0.66,0.24,4}, {0.99,0.24,5}, {1.32,0.4,7} } },
	{ id = "gancho",   name = "Gancho",          difficulty = 3, search = { "dance hook", "electronic riff" },
	  notes = { {0,0.22,7}, {0.31,0.22,5}, {0.62,0.22,2}, {0.93,0.22,5}, {1.24,0.46,0} } },
	{ id = "retro",    name = "Retro",           difficulty = 3, search = { "chiptune melody", "8 bit tune" },
	  notes = { {0,0.3,2}, {0.39,0.3,5}, {0.78,0.3,9}, {1.17,0.3,5}, {1.56,0.56,2} } },
	{ id = "blues",    name = "Blues",           difficulty = 3, search = { "blues guitar riff", "blues lick" },
	  notes = { {0,0.26,0}, {0.35,0.2,3}, {0.64,0.26,-2}, {0.99,0.2,3}, {1.28,0.52,-5} } },
	{ id = "vaiven",   name = "Vaivén",          difficulty = 2, search = { "two note melody", "simple riff" },
	  notes = { {0,0.28,4}, {0.37,0.24,4}, {0.7,0.34,-1}, {1.13,0.46,2} } },
	{ id = "opera",    name = "Ópera",           difficulty = 3, search = { "opera singing", "soprano" },
	  notes = { {0,0.62,-3}, {0.71,0.46,4}, {1.26,0.4,9}, {1.75,0.9,7} } },
	{ id = "remontada", name = "Remontada",      difficulty = 3, search = { "rising melody", "build up melody" },
	  notes = { {0,0.2,-5}, {0.29,0.2,0}, {0.58,0.2,4}, {0.87,0.2,7}, {1.16,0.24,9}, {1.49,0.62,4} } },
})

function SoundLibrary.packs()
	return packs
end

function SoundLibrary.get(id)
	return byId[id]
end

function SoundLibrary.all()
	local out = {}
	for _, p in ipairs(packs) do
		for _, s in ipairs(p.sounds) do
			table.insert(out, s)
		end
	end
	return out
end

-- A deterministic shuffle so every client in a room can derive the same order
-- from a single seed the server sends, instead of replicating whole playlists.
--
-- `enabled` is either nil (every pack), a pack id, or a set { [packId] = true }
-- — which is what a host's pack toggles produce. A set that turns everything
-- off falls back to every pack rather than producing an empty match.
function SoundLibrary.playlist(seed, count, enabled)
	local function allows(packId)
		if enabled == nil then
			return true
		end
		if type(enabled) == "string" then
			return enabled == packId
		end
		if type(enabled) == "table" then
			return enabled[packId] == true
		end
		return true
	end

	local pool = {}
	for _, p in ipairs(packs) do
		if allows(p.id) then
			for _, s in ipairs(p.sounds) do
				table.insert(pool, s)
			end
		end
	end

	-- Every pack off, or a filter that matched nothing: use the whole library.
	if #pool == 0 then
		for _, p in ipairs(packs) do
			for _, s in ipairs(p.sounds) do
				table.insert(pool, s)
			end
		end
	end
	local rng = Random.new(seed)
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local out = {}
	for i = 1, math.min(count, #pool) do
		out[i] = pool[i]
	end
	-- Survival asks for more sounds than the library holds: wrap, reshuffling.
	while #out < count do
		local extra = SoundLibrary.playlist(seed + #out, math.min(count - #out, #pool), enabled)
		for _, s in ipairs(extra) do
			table.insert(out, s)
		end
	end
	return out
end

-- Envelope used by the waveform renderer and by the synthesised fallback voice.
function SoundLibrary.envelope(notes, duration, samples)
	samples = samples or Config.TAKE.ENVELOPE_SAMPLES
	local out = table.create(samples, 0)
	for i = 1, samples do
		local t = (i - 0.5) / samples * duration
		for _, n in ipairs(notes) do
			if t >= n.t and t <= n.t + n.dur then
				-- Soft attack, soft release: reads as a voice, not a square gate.
				local local_t = (t - n.t) / math.max(n.dur, 1e-3)
				local shape = math.min(1, local_t / 0.18) * math.min(1, (1 - local_t) / 0.22 + 0.35)
				out[i] = math.clamp(0.35 + 0.65 * shape, 0, 1)
				break
			end
		end
	end
	return out
end

return SoundLibrary
]]></string>
        </Properties>
      </Item>
