	["lobby.gone"] = "Essa sala não existe mais.",
	["lobby.joining"] = "Entrando…",
	["lobby.creating"] = "Criando a sala…",
	["lobby.unavailable"] = "As salas só funcionam no jogo publicado, não no Studio.",
	["lobby.needName"] = "Dá um nome para a sala.",
	["lobby.back"] = "Voltar",
	["lobby.host"] = "de {host}",
