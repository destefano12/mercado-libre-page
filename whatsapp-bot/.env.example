# 1) Tu clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=pega_aqui_tu_clave

# 2) Modelo de Gemini (gemini-flash-latest es gratis y rápido)
GEMINI_MODEL=gemini-flash-latest

# 3) Tu número personal para que el bot te AVISE cuando no sepa algo.
#    Formato internacional, sin + ni espacios. Ej Chile: 56912345678
#    Si lo dejas vacío, te avisa a ti mismo (chat "Mensaje a mí mismo").
NUMERO_DUENO=

# 4) Puerto del panel web (abre http://localhost:3008)
PORT=3008
